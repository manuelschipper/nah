{
  "schema": "effinterp/satisfies-case/v1",
  "id": "windows-absolute-glob",
  "request": {
    "mode": "satisfies",
    "concrete": {
      "realm": {
        "realm": "host"
      },
      "identity": {
        "family": "fs_path",
        "path": "C:/work/a.rs"
      }
    },
    "expr": {
      "realm": {
        "realm": "host"
      },
      "expr": {
        "expr": "pattern",
        "pattern": {
          "family": "fs_path",
          "glob": "c:/work/*.rs"
        }
      }
    },
    "bindings": {
      "platform": "windows",
      "cwd": null,
      "env": {}
    }
  },
  "expected": {
    "kind": "satisfied",
    "proof": {
      "steps": [
        {
          "kind": "pattern"
        }
      ]
    }
  }
}
