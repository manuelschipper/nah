{
  "schema": "effinterp/satisfies-case/v1",
  "id": "foreign-realm-does-not-bind",
  "request": {
    "mode": "satisfies",
    "concrete": {
      "realm": {
        "realm": "container",
        "runtime": "docker",
        "name": "a"
      },
      "identity": {
        "family": "fs_path",
        "path": "/x"
      }
    },
    "expr": {
      "realm": {
        "realm": "container",
        "runtime": "docker",
        "name": "a"
      },
      "expr": {
        "expr": "environment",
        "name": "HOME"
      }
    },
    "bindings": {
      "platform": "posix",
      "cwd": null,
      "env": {
        "HOME": {
          "value": "/x",
          "source": {
            "kind": "declared"
          }
        }
      }
    }
  },
  "expected": {
    "kind": "indeterminate",
    "reason": {
      "kind": "unbound",
      "names": [
        "HOME"
      ]
    }
  }
}
