{
  "schema": "effinterp/fact-assertion-fixture/v1",
  "cases": [
    {
      "subject": {
        "kind": "shell",
        "source": "cryptsetup erase /dev/sda",
        "cwd": "/workspace/project",
        "context": {
          "env": {
            "HOME": "/home/test"
          }
        }
      },
      "required_effects": [
        {
          "query": {
            "assertion": {
              "effect": {
                "closure": {
                  "domain_full_or_boundary_free": {
                    "domain": "filesystem"
                  }
                },
                "selector": {
                  "attributes": [
                    {
                      "name": "keyslots_erased",
                      "test": {
                        "equals": true
                      }
                    },
                    {
                      "name": "raw_device",
                      "test": {
                        "equals": true
                      }
                    }
                  ],
                  "operation": {
                    "exact": "filesystem.write"
                  },
                  "resource": {
                    "rendered": {
                      "projection": "resource",
                      "text": {
                        "equals": "/dev/sda"
                      }
                    }
                  }
                }
              }
            },
            "schema_version": 2
          },
          "modality": "must-on-success"
        }
      ],
      "coverage": {
        "filesystem": {
          "level": "full"
        },
        "process": {
          "level": "full"
        }
      }
    }
  ]
}
