    {
      "subject": {
        "kind": "exec",
        "argv": [
          "docker",
          "run",
          "alpine",
          "mkdir",
          "-p",
          "/data/x"
        ],
        "cwd": "/w"
      },
      "required_effects": [
        {
          "query": {
            "assertion": {
              "effect": {
                "closure": {
                  "domain_full_or_boundary_free": {
                    "domain": "container"
                  }
                },
                "selector": {
