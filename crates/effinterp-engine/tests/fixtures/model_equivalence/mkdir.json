{
  "schema": "effinterp/fact-assertion-fixture/v1",
  "cases": [
    {
      "subject": {
        "kind": "exec",
        "argv": [
          "mkdir",
          "dir"
        ],
        "cwd": "/w"
      },
      "required_effects": [
        {
          "query": {
            "assertion": {
              "effect": {
                "closure": {
                  "domain_full_or_boundary_free": {
                    "domain": "filesystem"
                  }
                },
                "selector": {
                  "operation": {
                    "exact": "filesystem.create"
                  },
                  "resource": {
                    "rendered": {
                      "projection": "resource",
                      "text": {
                        "equals": "/w/dir"
                      }
                    }
                  }
                }
              }
            },
            "schema_version": 2
          },
          "modality": "may"
        }
      ],
      "coverage": {
        "filesystem": {
          "level": "full"
        },
        "process": {
          "level": "full"
        }
      }
    },
