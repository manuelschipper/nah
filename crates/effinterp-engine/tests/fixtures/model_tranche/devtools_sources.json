    ],
    "reviewed_surface": "Reviewed hosted verb groups, API method selectors, release/run download --dir/-D destinations, and unknown extension subcommands. JSON/query/pagination and PR options; release upload TAG FILES reads assets; run/release download honors --dir and --pattern; api --input reads a file. API -F/--field key=@path reads file payloads, literal fields do not read files, and symbolic fields or @- retain dynamic input boundaries; run list accepts --branch and --status. Exact API DELETE additionally requires unique scalar field keys and a bounded Go template grammar; malformed or unsupported template syntax retains a boundary.",
    "positive_argv": [
      [
        "gh",
        "pr",
        "list"
      ],
      [
        "gh",
        "issue",
        "create"
      ],
      [
        "gh",
        "repo",
        "clone",
        "owner/name"
      ],
      [
        "gh",
        "config",
        "set",
        "editor",
        "vim"
      ],
      [
        "gh",
        "release",
        "download",
        "--dir",
        "/srv/artifacts"
      ],
      [
        "gh",
        "run",
        "download",
        "-D",
        "/srv/artifacts"
      ],
      [
        "gh",
        "api",
        "-X",
        "HEAD",
        "repos/o/r"
      ],
      [
        "gh",
        "customverb",
        "foo"
      ]
    ],
    "negative_argv": [
      "gh-not-the-command"
    ],
    "expected_facts": [
      "environment.read",
      "filesystem.read",
      "filesystem.write",
      "network.download",
      "network.request",
      "network.upload"
    ],
    "expected_boundaries": [
      "unmodeled_subcommand",
      "unrecognized_arguments"
    ]
  },
