  {
    "id": "p18b/agents/amp@v1",
    "primary_documentation": [
      "https://ampcode.com/docs/cli",
      "https://ampcode.com/docs/cli/settings",
      "https://ampcode.com/docs/cli/execute-mode"
    ],
    "reviewed_surface": "Bare and execute sessions read user ~/.config/amp/settings.json or settings.jsonc and workspace .amp settings; AMP_API_KEY selects authentication. Only help/version are inert. Copied config, auth, MCP and updater mutations are not reviewed here and remain bounded.",
    "positive_argv": [
      [
        "amp"
      ],
      [
        "amp",
        "-x",
        "fix it"
      ],
      [
        "amp",
        "--version"
      ]
    ],
    "negative_argv": [
      "amp-not-the-command"
    ],
    "expected_facts": [
      "environment.read",
      "filesystem.read",
      "network.connect"
    ],
    "expected_boundaries": [
      "unmodeled_dynamic"
    ]
  },
