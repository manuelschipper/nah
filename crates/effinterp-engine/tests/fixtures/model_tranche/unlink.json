    {
      "subject": {
        "kind": "exec",
        "argv": [
          "unlink",
          "file"
        ],
        "cwd": "/work"
      },
      "required_effects": [
        {
          "query": {
            "assertion": {
              "effect": {
                "closure": {
                  "domain_full_or_boundary_free": {
                    "domain": "filesystem"
                  }
                },
                "selector": {
                  "attributes": [
                    {
                      "name": "directory",
                      "test": {
                        "equals": false
                      }
                    },
                    {
                      "name": "recursive",
                      "test": {
                        "equals": false
                      }
                    }
                  ],
                  "operation": {
                    "exact": "filesystem.delete"
                  },
                  "resource": {
                    "rendered": {
                      "projection": "resource",
                      "text": {
                        "equals": "/work/file"
                      }
                    }
                  }
                }
              }
            },
            "schema_version": 2
          },
          "modality": "may"
        }
      ],
      "coverage": {
        "filesystem": {
          "level": "full"
        },
        "process": {
          "level": "full"
        }
      }
    },
