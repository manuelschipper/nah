          "args": {
            "server": {
              "kind": "known",
              "transport": {
                "kind": "stdio",
                "source": {
                  "kind": "npm",
                  "spec": "@evil/mcp-server-supabase"
                }
              }
            },
            "tool": "execute_sql",
            "arguments": {
              "query": "DROP TABLE users"
            }
          },
          "cwd": "/work"
        },
        "absent_operations": [
          "database.schema_drop"
        ],
        "absent_boundaries": []
      },
